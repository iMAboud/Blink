<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:theming="using:ShareX.AvaloniaUI.Theming"
        x:Class="ShareX.UploadersLib.GoogleDriveCredentialsWindow"
        Title="Google Drive API Credentials"
        Width="480"
        MinWidth="420"
        SizeToContent="Height"
        CanResize="False"
        Background="{DynamicResource ShareX.Brush.Background.Main}"
        WindowStartupLocation="CenterScreen">

    <Window.Styles>
        <Style Selector="TextBlock.field-label">
            <Setter Property="Margin" Value="0,0,0,5"/>
            <Setter Property="Foreground" Value="{DynamicResource ShareX.Brush.Text.Secondary}"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>
        <Style Selector="Border.section-card">
            <Setter Property="Background" Value="{DynamicResource ShareX.Brush.Background.Panel}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource ShareX.Brush.Border}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="16"/>
        </Style>
        <Style Selector="Button.compact">
            <Setter Property="MinHeight" Value="32"/>
            <Setter Property="MinWidth" Value="90"/>
            <Setter Property="Padding" Value="14,5"/>
        </Style>
        <Style Selector="Button.primary">
            <Setter Property="Background" Value="{DynamicResource ShareX.Brush.Accent}"/>
            <Setter Property="Foreground" Value="{DynamicResource ShareX.Brush.Accent.Foreground}"/>
        </Style>
    </Window.Styles>

    <ThemeVariantScope>
        <Grid RowDefinitions="Auto,Auto"
              RowSpacing="12"
              Margin="16"
              Background="{DynamicResource ShareX.Brush.Background.Main}">
            <Border Classes="section-card">
                <Grid RowDefinitions="Auto,Auto,Auto,Auto" RowSpacing="11">
                    <StackPanel Spacing="4">
                        <TextBlock Text="Google Drive Credentials"
                                   FontSize="15"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource ShareX.Brush.Text}"/>
                        <TextBlock Text="To sign into Google Drive, provide an OAuth 2.0 Client ID for a Desktop App from Google Cloud Console."
                                   FontSize="12"
                                   Foreground="{DynamicResource ShareX.Brush.Text.Secondary}"
                                   TextWrapping="Wrap"/>
                    </StackPanel>

                    <StackPanel Grid.Row="1">
                        <TextBlock Classes="field-label" Text="Client ID:"/>
                        <TextBox x:Name="ClientIdTextBox"
                                 PlaceholderText="xxxxxx-xxxxxxxxxxxxxxxx.apps.googleusercontent.com"/>
                    </StackPanel>

                    <StackPanel Grid.Row="2">
                        <TextBlock Classes="field-label" Text="Client Secret:"/>
                        <TextBox x:Name="ClientSecretTextBox"
                                 PasswordChar="●"
                                 PlaceholderText="GOCSPX-xxxxxxxxxxxxxxxx"/>
                    </StackPanel>

                    <StackPanel Grid.Row="3" Spacing="6">
                        <HyperlinkButton Content="Open Google Cloud Console Credentials"
                                         HorizontalAlignment="Left"
                                         Padding="0"
                                         Click="OnConsoleLinkClick"/>
                        <TextBlock x:Name="StatusText"
                                   IsVisible="False"
                                   Foreground="{DynamicResource ShareX.Brush.TaskMode.Cancel.Border}"
                                   TextWrapping="Wrap"/>
                    </StackPanel>
                </Grid>
            </Border>

            <Grid Grid.Row="1" ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
                <Button Grid.Column="1"
                        Classes="compact"
                        Content="Cancel"
                        Click="OnCancelClick"/>
                <Button Grid.Column="2"
                        Classes="compact primary"
                        Content="Continue"
                        Click="OnSaveClick"/>
            </Grid>
        </Grid>
    </ThemeVariantScope>
</Window>
