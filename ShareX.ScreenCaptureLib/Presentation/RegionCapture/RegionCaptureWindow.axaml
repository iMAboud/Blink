<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:capture="using:ShareX.ScreenCaptureLib.Presentation.RegionCapture"
        xmlns:localization="using:ShareX.ScreenCaptureLib.Localization"
        xmlns:theming="using:ShareX.AvaloniaUI.Theming"
        x:Class="ShareX.ScreenCaptureLib.Presentation.RegionCapture.RegionCaptureWindow"
        WindowDecorations="None"
        CanResize="False"
        ShowInTaskbar="False"
        Background="Black"
        FontFamily="{DynamicResource ShareX.FontFamily.Default}"
        Foreground="{DynamicResource ShareX.Brush.Text}">
    <Grid x:Name="RootGrid" Background="Black">
        <!-- The region overlay uses image-pixel coordinates and is scaled once to physical pixels. -->
        <LayoutTransformControl x:Name="RegionTransform"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center">
            <Grid x:Name="RegionInputSurface"
                  Background="Transparent"
                  Focusable="True"
                  PointerPressed="OnRegionPointerPressed"
                  PointerMoved="OnRegionPointerMoved"
                  PointerReleased="OnRegionPointerReleased"
                  PointerWheelChanged="OnRegionPointerWheelChanged">
                <Image x:Name="BackgroundImage"
                       Stretch="Fill"
                       IsHitTestVisible="False"/>
                <capture:RegionSelectionOverlay x:Name="RegionOverlay"
                                                AccentBrush="{DynamicResource ShareX.Brush.Accent.Start}"
                                                IsHitTestVisible="False"/>
                <Canvas x:Name="RegionResizeNodeCanvas" IsVisible="False"/>
            </Grid>
        </LayoutTransformControl>

        <!-- HUD is deliberately separate from the image-pixel transform. -->
        <Canvas x:Name="HudCanvas" IsHitTestVisible="False">
            <StackPanel x:Name="MagnifierPanel"
                        Spacing="10"
                        IsVisible="False">
                <Grid x:Name="MagnifierView">
                    <!-- Legacy magnifier: white outer ring around a black inner ring. -->
                    <Ellipse x:Name="MagnifierCircleOuter" Fill="White"/>
                    <Border x:Name="MagnifierSquareOuter"
                            Background="White"
                            IsVisible="False"/>
                    <Grid x:Name="MagnifierContent">
                        <Image x:Name="MagnifierImage"
                               Stretch="Fill"
                               RenderOptions.BitmapInterpolationMode="None"/>
                        <capture:MagnifierPixelGrid x:Name="MagnifierPixelGrid"
                                                    AccentBrush="{DynamicResource ShareX.Brush.Accent.Start}"
                                                    RenderOptions.EdgeMode="Aliased"
                                                    IsHitTestVisible="False"/>
                    </Grid>
                    <Ellipse x:Name="MagnifierCircleInner"
                             Stroke="Black"
                             StrokeThickness="1"
                             IsHitTestVisible="False"/>
                    <Border x:Name="MagnifierSquareInner"
                            BorderBrush="Black"
                            BorderThickness="1"
                            IsVisible="False"
                            IsHitTestVisible="False"
                            RenderOptions.EdgeMode="Aliased"/>
                </Grid>
                <Border x:Name="PointerInfoPanel"
                        HorizontalAlignment="Center"
                        Padding="7,4"
                        CornerRadius="5"
                        Background="{DynamicResource ShareX.Brush.Background.Main}"
                        BorderBrush="{DynamicResource ShareX.Brush.Border}"
                        BorderThickness="1">
                    <TextBlock x:Name="PointerInfoText"
                               FontSize="12"
                               FontWeight="SemiBold"
                               TextAlignment="Center"/>
                </Border>
            </StackPanel>

            <Border x:Name="SelectionInfoPanel"
                    Padding="7,4"
                    CornerRadius="5"
                    Background="{DynamicResource ShareX.Brush.Background.Main}"
                    BorderBrush="{DynamicResource ShareX.Brush.Border}"
                    BorderThickness="1"
                    IsVisible="False">
                <TextBlock x:Name="SelectionInfoText" FontSize="12" FontWeight="SemiBold"/>
            </Border>
        </Canvas>
    </Grid>
</Window>
