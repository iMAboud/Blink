<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:local="using:ShareX"
             xmlns:res="using:ShareX.Localization"
             xmlns:controls="using:ShareX.AvaloniaUI.Controls"
             xmlns:theming="using:ShareX.AvaloniaUI.Theming"
             mc:Ignorable="d"
             d:DesignWidth="950"
             d:DesignHeight="720"
             x:Class="ShareX.ApplicationSettingsView"
             x:DataType="local:ApplicationSettingsViewModel">

    <UserControl.Styles>
        <Style Selector="Grid.page-title">
            <Setter Property="Margin" Value="0,0,0,14"/>
        </Style>
        <Style Selector="TextBlock.page-title-text">
            <Setter Property="FontSize" Value="24"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource ShareX.Brush.Accent}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style Selector="TextBlock.page-title-icon">
            <Setter Property="FontSize" Value="22"/>
            <Setter Property="Foreground" Value="{DynamicResource ShareX.Brush.Accent}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style Selector="TextBlock.section-title">
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource ShareX.Brush.Text}"/>
            <Setter Property="Margin" Value="0,4,0,3"/>
        </Style>
        <Style Selector="TextBlock.hint">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="Normal"/>
            <Setter Property="Foreground" Value="{DynamicResource ShareX.Brush.Text.Secondary}"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
        <Style Selector="Border.section-card">
            <Setter Property="Background" Value="{DynamicResource ShareX.Brush.Background.Panel}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource ShareX.Brush.Border}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Padding" Value="12"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
        </Style>
        <Style Selector="CheckBox.setting">
            <Setter Property="Margin" Value="0,1"/>
            <Setter Property="FontWeight" Value="Normal"/>
        </Style>
        <Style Selector="ComboBox.form-control">
            <Setter Property="MinWidth" Value="250"/>
            <Setter Property="MinHeight" Value="32"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="HorizontalAlignment" Value="Left"/>
        </Style>
        <Style Selector="TextBox.form-control">
            <Setter Property="MinWidth" Value="300"/>
            <Setter Property="MinHeight" Value="32"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
        </Style>
        <Style Selector="NumericUpDown.form-control">
            <Setter Property="Width" Value="130"/>
            <Setter Property="MinHeight" Value="32"/>
            <Setter Property="HorizontalAlignment" Value="Left"/>
        </Style>
        <Style Selector="Button.compact">
            <Setter Property="Height" Value="32"/>
            <Setter Property="Padding" Value="10,4"/>
        </Style>
        <Style Selector="ListBox.settings-list">
            <Setter Property="MinHeight" Value="170"/>
            <Setter Property="Background" Value="{DynamicResource ShareX.Brush.Background.Main}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource ShareX.Brush.Border}"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>
    </UserControl.Styles>

    <ThemeVariantScope>
        <Grid Background="{DynamicResource ShareX.Brush.Background.Main}"
              ColumnDefinitions="220,*">
            <Border Grid.Column="0"
                    Padding="8"
                    Background="{DynamicResource ShareX.Brush.Background.Toolbar}"
                    BorderBrush="{DynamicResource ShareX.Brush.Border}"
                    BorderThickness="0,0,1,0">
                <controls:SettingsNavigation Items="{Binding NavigationItems}"
                                             SelectedItem="{Binding SelectedNavigationItem, Mode=TwoWay}"
                                             SearchRoot="{Binding #SettingsPages}"/>
            </Border>

            <Grid Grid.Column="1" RowDefinitions="Auto,Auto,*">
                <Border Grid.Row="0"
                        IsVisible="{Binding RestartRequired}"
                        Margin="20,14,20,0"
                        Padding="12,8"
                        Background="{DynamicResource ShareX.Brush.Background.Panel}"
                        BorderBrush="{DynamicResource ShareX.Brush.Accent}"
                        BorderThickness="1"
                        CornerRadius="5">
                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">
                        <TextBlock Classes="icon" Text="{x:Static theming:LucideIcons.rotate_ccw}" FontSize="17"/>
                        <TextBlock Grid.Column="1" Text="{x:Static res:Strings.ApplicationSettingsWindow_RestartShareXToApplyThisChange}" FontWeight="Normal" VerticalAlignment="Center"/>
                        <Button Grid.Column="2" Classes="compact" Content="{x:Static res:Strings.ApplicationSettingsWindow_RestartNow}" Click="OnRestartClick"/>
                    </Grid>
                </Border>

                <Border Grid.Row="1"
                        IsVisible="{Binding HasStatusMessage}"
                        Margin="20,10,20,0"
                        Padding="12,8"
                        Background="{DynamicResource ShareX.Brush.Control.Background}"
                        BorderBrush="{DynamicResource ShareX.Brush.Border}"
                        BorderThickness="1"
                        CornerRadius="5">
                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
                        <ProgressBar Width="18" Height="18" IsIndeterminate="True" IsVisible="{Binding IsBusy}"/>
                        <TextBlock Grid.Column="1" Text="{Binding StatusMessage}" FontWeight="Normal" TextWrapping="Wrap"/>
                    </Grid>
                </Border>

                <Grid x:Name="SettingsPages" Grid.Row="2">
                    <!-- General -->
                    <ScrollViewer controls:SettingsSearch.PageId="general" IsVisible="{Binding IsGeneralPage}" HorizontalContentAlignment="Stretch" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel Margin="28,24,28,32" HorizontalAlignment="Stretch">
                            <Grid Classes="page-title" controls:SettingsSearch.IsPageTitle="True" ColumnDefinitions="Auto,*" ColumnSpacing="9">
                                <TextBlock Classes="icon page-title-icon" Text="{x:Static theming:LucideIcons.settings}"/>
                                <TextBlock Grid.Column="1" Classes="page-title-text" Text="{x:Static res:Strings.ApplicationSettingsWindow_General}"/>
                            </Grid>

                            <Border Classes="section-card" controls:SettingsSearch.IsPanel="True">
                                <StackPanel Spacing="4">
                                    <TextBlock Classes="section-title" Text="{x:Static res:Strings.ApplicationSettingsWindow_Application}"/>
                                    <Grid ColumnDefinitions="190,*" ColumnSpacing="8">
                                        <TextBlock Text="{x:Static res:Strings.ApplicationSettingsWindow_LanguageLabel}" VerticalAlignment="Center" FontWeight="Normal"/>
                                        <ComboBox Grid.Column="1" Classes="form-control"
                                                  ItemsSource="{Binding LanguageOptions}"
                                                  SelectedItem="{Binding SelectedLanguage, Mode=TwoWay}">
                                            <ComboBox.ItemTemplate>
                                                <DataTemplate x:DataType="local:LanguageOption">
                                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                                        <Grid Width="16" Height="16">
                                                            <TextBlock Classes="icon" Text="{Binding IconGlyph}" FontSize="16"
                                                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                            <Image Source="{Binding Flag}" Stretch="Uniform"/>
                                                        </Grid>
                                                        <TextBlock Text="{Binding DisplayName}" VerticalAlignment="Center"/>
                                                    </StackPanel>
                                                </DataTemplate>
                                            </ComboBox.ItemTemplate>
                                        </ComboBox>
                                    </Grid>
                                    <CheckBox Classes="setting" Content="{x:Static res:Strings.ApplicationSettingsWindow_ShowTrayIcon}" IsChecked="{Binding ShowTray, Mode=TwoWay}"/>
                                    <CheckBox Classes="setting" Content="{Binding StartWithWindowsText}" IsEnabled="{Binding StartWithWindowsEnabled}" IsChecked="{Binding StartWithWindows, Mode=TwoWay}"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- Theme -->
                    <ScrollViewer controls:SettingsSearch.PageId="theme" IsVisible="{Binding IsThemePage}" HorizontalContentAlignment="Stretch" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel Margin="28,24,28,32" HorizontalAlignment="Stretch">
                            <Grid Classes="page-title" controls:SettingsSearch.IsPageTitle="True" ColumnDefinitions="Auto,*" ColumnSpacing="9">
                                <TextBlock Classes="icon page-title-icon" Text="{x:Static theming:LucideIcons.palette}"/>
                                <TextBlock Grid.Column="1" Classes="page-title-text" Text="{x:Static res:Strings.ApplicationSettingsWindow_Theme}"/>
                            </Grid>

                            <Border Classes="section-card" controls:SettingsSearch.IsPanel="True">
                                <StackPanel Spacing="6">
                                    <TextBlock Classes="section-title" Text="{x:Static res:Strings.ApplicationSettingsWindow_ApplicationTheme}"/>
                                    <CheckBox Classes="setting"
                                              Content="{x:Static res:Strings.ApplicationSettingsWindow_FollowSystemTheme}"
                                              IsChecked="{Binding UseSystemTheme, Mode=TwoWay}"/>
                                    <Grid ColumnDefinitions="190,*"
                                          ColumnSpacing="8"
                                          IsVisible="{Binding CanEditTheme}">
                                        <TextBlock Text="{x:Static res:Strings.ApplicationSettingsWindow_ThemeLabel}" VerticalAlignment="Center" FontWeight="Normal"/>
                                        <ComboBox Grid.Column="1"
                                                  Classes="form-control"
                                                  Width="130"
                                                  MinWidth="130"
                                                  ItemsSource="{Binding ThemeOptions}"
                                                  SelectedItem="{Binding SelectedTheme, Mode=TwoWay}"/>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <Border Classes="section-card" controls:SettingsSearch.IsPanel="True">
                                <StackPanel Spacing="6">
                                    <TextBlock Classes="section-title" Text="{x:Static res:Strings.ApplicationSettingsWindow_AccentColor}"/>
                                    <CheckBox Classes="setting"
                                              Content="{x:Static res:Strings.ApplicationSettingsWindow_FollowSystemAccentColor}"
                                              IsChecked="{Binding UseSystemAccentColor, Mode=TwoWay}"/>
                                    <Grid ColumnDefinitions="190,*"
                                          ColumnSpacing="8"
                                          IsVisible="{Binding CanEditAccentColor}">
                                        <TextBlock Text="{x:Static res:Strings.ApplicationSettingsWindow_AccentColorLabel}" VerticalAlignment="Center" FontWeight="Normal"/>
                                        <controls:ColorPickerDropdown Grid.Column="1"
                                                                                 SelectedColorValue="{Binding AccentColor, Mode=TwoWay}"
                                                                                 HorizontalAlignment="Left"
                                                                                 MinWidth="130"
                                                                                 VerticalAlignment="Center"/>
                                    </Grid>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>


                    <!-- Updater -->
                    <ScrollViewer controls:SettingsSearch.PageId="updater" IsVisible="{Binding IsUpdaterPage}" HorizontalContentAlignment="Stretch" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel Margin="28,24,28,32" HorizontalAlignment="Stretch" Spacing="16">
                            <Grid Classes="page-title" controls:SettingsSearch.IsPageTitle="True" ColumnDefinitions="Auto,*" ColumnSpacing="9">
                                <TextBlock Classes="icon page-title-icon" Text="{x:Static theming:LucideIcons.download}"/>
                                <TextBlock Grid.Column="1" Classes="page-title-text" Text="Updater"/>
                            </Grid>

                            <Border Classes="section-card" controls:SettingsSearch.IsPanel="True">
                                <StackPanel Spacing="12">
                                    <TextBlock Classes="section-title" Text="Update Settings"/>
                                    <CheckBox Classes="setting" Content="Automatically check for updates on startup" IsChecked="{Binding AutoCheckUpdate, Mode=TwoWay}"/>
                                    
                                    <Grid ColumnDefinitions="190,*" ColumnSpacing="8">
                                        <TextBlock Text="Current Version:" VerticalAlignment="Center" FontWeight="Normal"/>
                                        <TextBlock Grid.Column="1" Text="{Binding CurrentVersionText}" VerticalAlignment="Center" FontWeight="SemiBold"/>
                                    </Grid>

                                    <Grid ColumnDefinitions="190,*" ColumnSpacing="8" IsVisible="{Binding IsUpdateAvailable}">
                                        <TextBlock Text="Latest Version:" VerticalAlignment="Center" FontWeight="Normal"/>
                                        <TextBlock Grid.Column="1" Text="{Binding LatestVersionText}" VerticalAlignment="Center" FontWeight="SemiBold" Foreground="#10B981"/>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <Border Classes="section-card" controls:SettingsSearch.IsPanel="True">
                                <StackPanel Spacing="12">
                                    <TextBlock Classes="section-title" Text="Status &amp; Actions"/>
                                    
                                    <TextBlock Text="{Binding UpdateStatusText}" VerticalAlignment="Center"/>

                                    <ProgressBar Minimum="0" Maximum="100" Value="{Binding UpdateProgress}"
                                                 IsVisible="{Binding IsUpdating}" Height="8" HorizontalAlignment="Stretch"/>

                                    <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,8,0,0">
                                        <Button Classes="compact" Content="Check for Updates" Click="OnCheckForUpdatesClick" IsEnabled="{Binding !IsUpdating}"/>
                                        <Button Classes="compact" Content="Update Now" Click="OnInstallUpdateClick" IsVisible="{Binding IsUpdateAvailable}" IsEnabled="{Binding !IsUpdating}"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- Paths -->
                    <ScrollViewer controls:SettingsSearch.PageId="paths" IsVisible="{Binding IsPathsPage}" HorizontalContentAlignment="Stretch" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel Margin="28,24,28,32" HorizontalAlignment="Stretch">
                            <Grid Classes="page-title" controls:SettingsSearch.IsPageTitle="True" ColumnDefinitions="Auto,*" ColumnSpacing="9">
                                <TextBlock Classes="icon page-title-icon" Text="{x:Static theming:LucideIcons.folder}"/>
                                <TextBlock Grid.Column="1" Classes="page-title-text" Text="{x:Static res:Strings.ApplicationSettingsWindow_Paths}"/>
                            </Grid>
                            <Border Classes="section-card" controls:SettingsSearch.IsPanel="True">
                                <StackPanel Spacing="6">
                                    <TextBlock Classes="section-title" Text="{x:Static res:Strings.ApplicationSettingsWindow_ShareXPersonalFolder}"/>
                                    <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
                                        <TextBox Classes="form-control" Text="{Binding PersonalFolderPath, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                        <Button Grid.Column="1" Classes="compact" Content="{x:Static res:Strings.ApplicationSettingsWindow_Browse}" Click="OnBrowsePersonalFolderClick"/>
                                        <Button Grid.Column="2" Classes="compact" Content="{x:Static res:Strings.ApplicationSettingsWindow_Open}" Click="OnOpenPersonalFolderClick"/>
                                    </Grid>
                                    <TextBlock Classes="hint" Text="{Binding PersonalFolderPreview}"/>
                                    <TextBlock Classes="hint" Text="{x:Static res:Strings.ApplicationSettingsWindow_ChangesToThePersonalFolderAreStoredImmediatelyAndTakeEffectAfterRestart}"/>
                                </StackPanel>
                            </Border>
                            <Border Classes="section-card" controls:SettingsSearch.IsPanel="True">
                                <StackPanel Spacing="6">
                                    <TextBlock Classes="section-title" Text="{x:Static res:Strings.ApplicationSettingsWindow_ScreenshotsFolder}"/>
                                    <CheckBox Classes="setting" Content="{x:Static res:Strings.ApplicationSettingsWindow_UseCustomScreenshotsFolder}" IsChecked="{Binding UseCustomScreenshotsPath, Mode=TwoWay}"/>
                                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                        <TextBox Classes="form-control" Text="{Binding CustomScreenshotsPath, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                        <Button Grid.Column="1" Classes="compact" Content="{x:Static res:Strings.ApplicationSettingsWindow_Browse}" Click="OnBrowseScreenshotsFolderClick"/>
                                    </Grid>
                                    <Grid ColumnDefinitions="210,*" ColumnSpacing="8">
                                        <TextBlock Text="{x:Static res:Strings.ApplicationSettingsWindow_SubFolderPatternLabel}" VerticalAlignment="Center" FontWeight="Normal"/>
                                        <TextBox x:Name="SaveImageSubFolderPatternTextBox" Grid.Column="1" Classes="form-control" Text="{Binding SaveImageSubFolderPattern, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                    </Grid>
                                    <Grid ColumnDefinitions="210,*" ColumnSpacing="8">
                                        <TextBlock Text="{x:Static res:Strings.ApplicationSettingsWindow_SubFolderPatternForWindowLabel}" VerticalAlignment="Center" FontWeight="Normal"/>
                                        <TextBox x:Name="SaveImageSubFolderPatternWindowTextBox" Grid.Column="1" Classes="form-control" Text="{Binding SaveImageSubFolderPatternWindow, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                    </Grid>
                                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                        <TextBlock Classes="hint" Text="{Binding ScreenshotsFolderPreview}" VerticalAlignment="Center"/>
                                        <Button Grid.Column="1" Classes="compact" Content="{x:Static res:Strings.ApplicationSettingsWindow_Open}" Click="OnOpenScreenshotsFolderClick"/>
                                    </Grid>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- Settings backup and cleanup -->
                    <ScrollViewer controls:SettingsSearch.PageId="settings" IsVisible="{Binding IsSettingsPage}" HorizontalContentAlignment="Stretch" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel Margin="28,24,28,32" HorizontalAlignment="Stretch">
                            <Grid Classes="page-title" controls:SettingsSearch.IsPageTitle="True" ColumnDefinitions="Auto,*" ColumnSpacing="9">
                                <TextBlock Classes="icon page-title-icon" Text="{x:Static theming:LucideIcons.database_backup}"/>
                                <TextBlock Grid.Column="1" Classes="page-title-text" Text="{x:Static res:Strings.ApplicationSettingsWindow_Settings}"/>
                            </Grid>
                            <Border Classes="section-card" controls:SettingsSearch.IsPanel="True">
                                <StackPanel Spacing="6">
                                    <TextBlock Classes="section-title" Text="{x:Static res:Strings.ApplicationSettingsWindow_ExportAndImport}"/>
                                    <TextBlock Classes="hint" Text="{x:Static res:Strings.ApplicationSettingsWindow_DoNotShareAnExportedBackupItCanContainPrivateInformationSuchAsAccountDetailsAndUploadHistory}"/>
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <CheckBox Classes="setting" Content="{x:Static res:Strings.ApplicationSettingsWindow_Settings}" IsChecked="{Binding ExportSettings, Mode=TwoWay}"/>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" Spacing="5">
                                        <Button Classes="compact" Content="{x:Static res:Strings.ApplicationSettingsWindow_Export}" IsEnabled="{Binding CanExport}" Click="OnExportClick"/>
                                        <Button Classes="compact" Content="{x:Static res:Strings.ApplicationSettingsWindow_Import}" IsEnabled="{Binding !IsBusy}" Click="OnImportClick"/>
                                        <Button Classes="compact" Content="{x:Static res:Strings.ApplicationSettingsWindow_ResetSettings}" IsEnabled="{Binding !IsBusy}" Click="OnResetSettingsClick"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                            <Border Classes="section-card" controls:SettingsSearch.IsPanel="True">
                                <StackPanel Spacing="6">
                                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
                                        <TextBlock Classes="icon" Text="{x:Static theming:LucideIcons.cloud}" FontSize="16" Foreground="{DynamicResource ShareX.Brush.Accent.Start}" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="1" Classes="section-title" Text="Google Drive Cloud Backup" VerticalAlignment="Center"/>
                                    </Grid>
                                    <TextBlock Classes="hint" Text="Backup all your settings and configurations to a single .bkb file in your personal Google Drive, or restore them onto this device."/>
                                    <TextBlock Text="{Binding GoogleDriveAccountText}"
                                               FontSize="12"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource ShareX.Brush.Text}"/>
                                    <TextBlock Text="{Binding GoogleDriveStatusText}"
                                               FontSize="12"
                                               Foreground="{DynamicResource ShareX.Brush.Text.Secondary}"
                                               IsVisible="{Binding HasGoogleDriveStatus}"/>
                                    <StackPanel Orientation="Horizontal" Spacing="6" IsVisible="{Binding !IsGoogleDriveConnected}">
                                        <Button Classes="compact" IsEnabled="{Binding !IsGoogleDriveBusy}" Click="OnGoogleDriveLoginClick">
                                            <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                                <Viewbox Width="14" Height="14" VerticalAlignment="Center">
                                                    <Canvas Width="24" Height="24">
                                                        <Path Fill="#4285F4" Data="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z"/>
                                                        <Path Fill="#34A853" Data="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z"/>
                                                        <Path Fill="#FBBC05" Data="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.06H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.94l2.85-2.22.81-.63z"/>
                                                        <Path Fill="#EA4335" Data="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.06l3.66 2.84c.87-2.6 3.3-4.52 6.16-4.52z"/>
                                                    </Canvas>
                                                </Viewbox>
                                                <TextBlock Text="Login" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Button>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" Spacing="6" IsVisible="{Binding IsGoogleDriveConnected}">
                                        <Button Classes="compact" Content="Backup to Google Drive" IsEnabled="{Binding !IsGoogleDriveBusy}" Click="OnGoogleDriveBackupClick"/>
                                        <Button Classes="compact" Content="Restore from Google Drive" IsEnabled="{Binding !IsGoogleDriveBusy}" Click="OnGoogleDriveRestoreClick"/>
                                        <Button Classes="compact" Content="Disconnect" IsEnabled="{Binding !IsGoogleDriveBusy}" Click="OnGoogleDriveDisconnectClick"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- History -->
                    <ScrollViewer controls:SettingsSearch.PageId="recent-tasks" IsVisible="{Binding IsRecentTasksPage}" HorizontalContentAlignment="Stretch" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel Margin="28,24,28,32" HorizontalAlignment="Stretch">
                            <Grid Classes="page-title" controls:SettingsSearch.IsPageTitle="True" ColumnDefinitions="Auto,*" ColumnSpacing="9">
                                <TextBlock Classes="icon page-title-icon" Text="{x:Static theming:LucideIcons.clock}"/>
                                <TextBlock Grid.Column="1" Classes="page-title-text" Text="{x:Static res:Strings.ApplicationSettingsWindow_RecentTasks}"/>
                            </Grid>

                            <Border Classes="section-card" controls:SettingsSearch.IsPanel="True">
                                <StackPanel Spacing="4">
                                    <TextBlock Classes="section-title" Text="{x:Static res:Strings.ApplicationSettingsWindow_RecentTasks}"/>
                                    <CheckBox Classes="setting" Content="{x:Static res:Strings.ApplicationSettingsWindow_SaveRecentTasks}" IsChecked="{Binding RecentTasksSave, Mode=TwoWay}"/>
                                    <Grid ColumnDefinitions="230,*" ColumnSpacing="8">
                                        <TextBlock Text="{x:Static res:Strings.ApplicationSettingsWindow_MaximumNumberOfTasksToSaveLabel}" VerticalAlignment="Center" FontWeight="Normal"/>
                                        <NumericUpDown Grid.Column="1" Classes="form-control" Minimum="1" Maximum="10000" Value="{Binding RecentTasksMaxCount, Mode=TwoWay}"/>
                                    </Grid>
                                    <CheckBox Classes="setting" Content="{x:Static res:Strings.ApplicationSettingsWindow_ShowRecentTasksInMainWindowOnStartup}" IsChecked="{Binding RecentTasksShowInMainWindow, Mode=TwoWay}"/>
                                    <CheckBox Classes="setting" Content="{x:Static res:Strings.ApplicationSettingsWindow_ShowRecentTasksInTrayMenu}" IsChecked="{Binding RecentTasksShowInTrayMenu, Mode=TwoWay}"/>
                                    <CheckBox Classes="setting" Content="{x:Static res:Strings.ApplicationSettingsWindow_InTrayMenuShowMostRecentTasksFirst}" IsChecked="{Binding RecentTasksTrayMenuMostRecentFirst, Mode=TwoWay}"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- System Tray -->
                    <ScrollViewer controls:SettingsSearch.PageId="tray" IsVisible="{Binding IsTrayPage}" HorizontalContentAlignment="Stretch" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel Margin="28,24,28,32" HorizontalAlignment="Stretch">
                            <Grid Classes="page-title" controls:SettingsSearch.IsPageTitle="True" ColumnDefinitions="Auto,*" ColumnSpacing="9">
                                <TextBlock Classes="icon page-title-icon" Text="{x:Static theming:LucideIcons.panel_bottom}"/>
                                <TextBlock Grid.Column="1" Classes="page-title-text" Text="System Tray"/>
                            </Grid>
                            <Border Classes="section-card" controls:SettingsSearch.IsPanel="True">
                                <StackPanel Spacing="6">
                                    <TextBlock Classes="section-title" Text="System Tray Options"/>
                                    <CheckBox Classes="setting" Content="{x:Static res:Strings.ApplicationSettingsWindow_ShowTrayIcon}" IsChecked="{Binding ShowTray, Mode=TwoWay}"/>
                                    <Grid ColumnDefinitions="220,*" ColumnSpacing="8">
                                        <TextBlock Text="Click Action" VerticalAlignment="Center" FontWeight="Normal"/>
                                        <ComboBox Grid.Column="1" Classes="form-control" ItemsSource="{Binding HotkeyTypeOptions}" SelectedItem="{Binding SelectedTrayLeftClickAction, Mode=TwoWay}"/>
                                    </Grid>
                                </StackPanel>
                            </Border>
                            <Border Classes="section-card" controls:SettingsSearch.IsPanel="True">
                                <StackPanel Spacing="6">
                                    <TextBlock Classes="section-title" Text="Tray Menu Customization"/>
                                    <TextBlock Classes="hint" Text="Select which options show or hide in the system tray right-click menu. Settings and Exit cannot be removed."/>
                                    <ItemsControl ItemsSource="{Binding TrayMenuItems}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="local:TrayMenuItemModel">
                                                <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,4">
                                                    <CheckBox IsChecked="{Binding IsVisible, Mode=TwoWay}" IsEnabled="{Binding !IsMandatory}"/>
                                                    <TextBlock Classes="icon" Text="{Binding IconGlyph}" FontSize="15" VerticalAlignment="Center"/>
                                                    <TextBlock Text="{Binding Title}" VerticalAlignment="Center"/>
                                                </StackPanel>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- Advanced -->
                    <ScrollViewer controls:SettingsSearch.PageId="advanced" IsVisible="{Binding IsAdvancedPage}" HorizontalContentAlignment="Stretch" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel Margin="28,24,28,32" HorizontalAlignment="Stretch">
                            <Grid Classes="page-title" controls:SettingsSearch.IsPageTitle="True" ColumnDefinitions="Auto,*" ColumnSpacing="9">
                                <TextBlock Classes="icon page-title-icon" Text="{x:Static theming:LucideIcons.sliders_horizontal}"/>
                                <TextBlock Grid.Column="1" Classes="page-title-text" Text="{x:Static res:Strings.ApplicationSettingsWindow_Advanced}"/>
                            </Grid>
                            <Border Classes="section-card" controls:SettingsSearch.IsPanel="True">
                                <StackPanel Spacing="6">
                                    <TextBlock Classes="section-title" Text="{x:Static res:Strings.ApplicationSettingsWindow_AdvancedApplication}"/>
                                    <StackPanel>
                                        <CheckBox Classes="setting" Content="{x:Static res:Strings.ApplicationSettingsWindow_ShowMostRecentTaskFirst}" IsChecked="{Binding ShowMostRecentTaskFirst, Mode=TwoWay}"/>
                                    </StackPanel>
                                    <StackPanel>
                                        <CheckBox Classes="setting" Content="{x:Static res:Strings.ApplicationSettingsWindow_WorkflowsOnlyShowEdited}" IsChecked="{Binding WorkflowsOnlyShowEdited, Mode=TwoWay}"/>
                                    </StackPanel>
                                    <StackPanel>
                                        <CheckBox Classes="setting" Content="{x:Static res:Strings.ApplicationSettingsWindow_TrayAutoExpandCaptureMenu}" IsChecked="{Binding TrayAutoExpandCaptureMenu, Mode=TwoWay}"/>
                                    </StackPanel>
                                    <Grid ColumnDefinitions="240,*" ColumnSpacing="8">
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="{x:Static res:Strings.ApplicationSettingsWindow_BrowserPath}" FontWeight="Normal"/>
                                        </StackPanel>
                                        <TextBox Grid.Column="1" Classes="form-control" Text="{Binding BrowserPath, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                    </Grid>
                                    <StackPanel>
                                        <CheckBox Classes="setting" Content="{x:Static res:Strings.ApplicationSettingsWindow_SaveSettingsAfterTaskCompleted}" IsChecked="{Binding SaveSettingsAfterTaskCompleted, Mode=TwoWay}"/>
                                    </StackPanel>
                                    <StackPanel>
                                        <CheckBox Classes="setting" Content="{x:Static res:Strings.ApplicationSettingsWindow_DevMode}" IsChecked="{Binding DevMode, Mode=TwoWay}"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <Border Classes="section-card" controls:SettingsSearch.IsPanel="True">
                                <StackPanel Spacing="6">
                                    <TextBlock Classes="section-title" Text="{x:Static res:Strings.ApplicationSettingsWindow_AdvancedHotkeys}"/>
                                    <StackPanel>
                                        <CheckBox Classes="setting" Content="{x:Static res:Strings.ApplicationSettingsWindow_DisableHotkeys}" IsChecked="{Binding DisableHotkeys, Mode=TwoWay}"/>
                                    </StackPanel>
                                    <StackPanel>
                                        <CheckBox Classes="setting" Content="{x:Static res:Strings.ApplicationSettingsWindow_DisableHotkeysOnFullscreen}" IsChecked="{Binding DisableHotkeysOnFullscreen, Mode=TwoWay}"/>
                                    </StackPanel>
                                    <Grid ColumnDefinitions="240,*" ColumnSpacing="8">
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="{x:Static res:Strings.ApplicationSettingsWindow_HotkeyRepeatLimit}" FontWeight="Normal"/>
                                        </StackPanel>
                                        <NumericUpDown Grid.Column="1" Classes="form-control" Minimum="200" Maximum="2147483647" Value="{Binding HotkeyRepeatLimit, Mode=TwoWay}"/>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <Border Classes="section-card" controls:SettingsSearch.IsPanel="True">
                                <StackPanel Spacing="6">
                                    <TextBlock Classes="section-title" Text="{x:Static res:Strings.ApplicationSettingsWindow_AdvancedClipboard}"/>
                                    <StackPanel>
                                        <CheckBox Classes="setting" Content="{x:Static res:Strings.ApplicationSettingsWindow_ShowClipboardContentViewer}" IsChecked="{Binding ShowClipboardContentViewer, Mode=TwoWay}"/>
                                    </StackPanel>
                                    <StackPanel>
                                        <CheckBox Classes="setting" Content="{x:Static res:Strings.ApplicationSettingsWindow_DefaultClipboardCopyImageFillBackground}" IsChecked="{Binding DefaultClipboardCopyImageFillBackground, Mode=TwoWay}"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <Border Classes="section-card" controls:SettingsSearch.IsPanel="True">
                                <StackPanel Spacing="6">
                                    <TextBlock Classes="section-title" Text="{x:Static res:Strings.ApplicationSettingsWindow_AdvancedUpload}"/>
                                    <StackPanel>
                                        <CheckBox Classes="setting" Content="{x:Static res:Strings.ApplicationSettingsWindow_DisableUpload}" IsChecked="{Binding DisableUpload, Mode=TwoWay}"/>
                                    </StackPanel>
                                    <StackPanel>
                                        <CheckBox Classes="setting" Content="{x:Static res:Strings.ApplicationSettingsWindow_URLEncodeIgnoreEmoji}" IsChecked="{Binding URLEncodeIgnoreEmoji, Mode=TwoWay}"/>
                                    </StackPanel>
                                    <StackPanel>
                                        <CheckBox Classes="setting" Content="{x:Static res:Strings.ApplicationSettingsWindow_ShowMultiUploadWarning}" IsChecked="{Binding ShowMultiUploadWarning, Mode=TwoWay}"/>
                                    </StackPanel>
                                    <Grid ColumnDefinitions="240,*" ColumnSpacing="8">
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="{x:Static res:Strings.ApplicationSettingsWindow_ShowLargeFileSizeWarning}" FontWeight="Normal"/>
                                        </StackPanel>
                                        <NumericUpDown Grid.Column="1" Classes="form-control" Minimum="0" Maximum="2147483647" Value="{Binding ShowLargeFileSizeWarning, Mode=TwoWay}"/>
                                    </Grid>
                                </StackPanel>
                            </Border>

                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Grid>

            <Border x:Name="ClipboardFormatEditorOverlay"
                    Grid.ColumnSpan="2"
                    ZIndex="100"
                    IsVisible="False"
                    Background="{DynamicResource ShareX.Brush.Overlay.Modal}">
                <Border Width="640"
                        MaxHeight="560"
                        Padding="16"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Background="{DynamicResource ShareX.Brush.Background.Panel}"
                        BorderBrush="{DynamicResource ShareX.Brush.Border}"
                        BorderThickness="1"
                        CornerRadius="8">
                    <Grid RowDefinitions="Auto,*,Auto" RowSpacing="12">
                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="9">
                            <TextBlock Classes="icon"
                                       Text="{x:Static theming:LucideIcons.clipboard_list}"
                                       FontSize="21"
                                       Foreground="{DynamicResource ShareX.Brush.Accent}"
                                       VerticalAlignment="Center"/>
                            <StackPanel Grid.Column="1" Spacing="1">
                                <TextBlock x:Name="ClipboardFormatEditorTitle"
                                           Text="{x:Static res:Strings.ApplicationSettingsWindow_AddClipboardFormat}"
                                           FontSize="19"
                                           FontWeight="SemiBold"/>
                                <TextBlock Classes="hint"
                                           Text="{x:Static res:Strings.ApplicationSettingsWindow_CustomizeTheTextCopiedFromCompletedUploads}"/>
                            </StackPanel>
                        </Grid>

                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                            <StackPanel Spacing="8" Margin="0,0,4,0">
                                <StackPanel Spacing="3">
                                    <TextBlock Text="{x:Static res:Strings.ApplicationSettingsWindow_Description}" FontWeight="Normal"/>
                                    <TextBox x:Name="ClipboardFormatDescriptionBox" Classes="form-control"/>
                                </StackPanel>
                                <StackPanel Spacing="3">
                                    <TextBlock Text="{x:Static res:Strings.ApplicationSettingsWindow_Format}" FontWeight="Normal"/>
                                    <TextBox x:Name="ClipboardFormatTextBox"
                                             Classes="form-control"
                                             Height="150"
                                             AcceptsReturn="True"
                                             VerticalContentAlignment="Top"
                                             TextWrapping="Wrap"
                                             ScrollViewer.VerticalScrollBarVisibility="Auto"/>
                                    <TextBlock Classes="hint" Text="{x:Static res:Strings.ApplicationSettingsWindow_RightClickToInsertAVariable}"/>
                                </StackPanel>
                                <TextBlock x:Name="ClipboardFormatSupportedVariablesText"
                                           Classes="hint"
                                           TextWrapping="Wrap"/>
                            </StackPanel>
                        </ScrollViewer>

                        <StackPanel Grid.Row="2"
                                    Orientation="Horizontal"
                                    Spacing="8"
                                    HorizontalAlignment="Right">
                            <Button Classes="compact"
                                    MinWidth="84"
                                    Content="{x:Static res:Strings.ApplicationSettingsWindow_Save}"
                                    Click="OnSaveClipboardFormatClick"/>
                            <Button Classes="compact"
                                    MinWidth="84"
                                    Content="{x:Static res:Strings.ApplicationSettingsWindow_Cancel}"
                                    Click="OnCancelClipboardFormatClick"/>
                        </StackPanel>
                    </Grid>
                </Border>
            </Border>
        </Grid>
    </ThemeVariantScope>
</UserControl>
