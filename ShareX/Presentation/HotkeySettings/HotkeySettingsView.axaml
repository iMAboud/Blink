<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:local="using:ShareX"
             xmlns:res="using:ShareX.Localization"
             xmlns:theming="using:ShareX.AvaloniaUI.Theming"
             mc:Ignorable="d"
             d:DesignWidth="680"
             d:DesignHeight="600"
             x:Class="ShareX.HotkeySettingsView"
             x:DataType="local:HotkeySettingsViewModel">

    <UserControl.Styles>
        <Style Selector="Border.hotkey-item">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="CornerRadius" Value="4"/>
            <Setter Property="Padding" Value="4,3"/>
        </Style>
        <Style Selector="Border.hotkey-item.selected">
            <Setter Property="Background" Value="{DynamicResource ShareX.Brush.Control.Background.Hover}"/>
        </Style>
        <Style Selector="Border.hotkey-item:pointerover">
            <Setter Property="Background" Value="{DynamicResource ShareX.Brush.Control.Background.Hover}"/>
        </Style>
        <Style Selector="ListBoxItem">
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="0"/>
            <Setter Property="MinHeight" Value="0"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Background" Value="Transparent"/>
        </Style>
        <Style Selector="ListBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="Transparent"/>
        </Style>
        <Style Selector="ListBoxItem:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="Transparent"/>
        </Style>
        <Style Selector="Button.row-icon-button">
            <Setter Property="Width" Value="34"/>
            <Setter Property="MinWidth" Value="34"/>
            <Setter Property="Height" Value="34"/>
            <Setter Property="Padding" Value="0"/>
        </Style>
        <Style Selector="Button.hotkey-capture">
            <Setter Property="Height" Value="34"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="Padding" Value="16,4"/>
        </Style>
        <Style Selector="Button.task-selector">
            <Setter Property="Height" Value="34"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Padding" Value="8,4"/>
        </Style>
        <Style Selector="Button.compact">
            <Setter Property="Height" Value="34"/>
            <Setter Property="Padding" Value="9,4"/>
        </Style>
        <Style Selector="TextBlock.column-heading">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="Normal"/>
            <Setter Property="Foreground" Value="{DynamicResource ShareX.Brush.Text.Secondary}"/>
        </Style>
        <Style Selector="Button.add-hotkey-placeholder">
            <Setter Property="Height" Value="40"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="0,2,0,0"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style Selector="Button.add-hotkey-placeholder /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>
        <Style Selector="Border.hotkey-placeholder-border">
            <Setter Property="Background" Value="{DynamicResource ShareX.Brush.Control.Background}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource ShareX.Brush.Border}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Padding" Value="4,3"/>
            <Setter Property="Opacity" Value="0.6"/>
            <Setter Property="Transitions">
                <Transitions>
                    <DoubleTransition Property="Opacity" Duration="0:0:0.15"/>
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Button.add-hotkey-placeholder:pointerover Border.hotkey-placeholder-border">
            <Setter Property="Opacity" Value="0.95"/>
            <Setter Property="Background" Value="{DynamicResource ShareX.Brush.Control.Background.Hover}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource ShareX.Brush.Accent}"/>
        </Style>
    </UserControl.Styles>

    <ThemeVariantScope>
        <Grid Background="{DynamicResource ShareX.Brush.Background.Main}">
            <Grid Margin="10,0,10,10" RowDefinitions="Auto,Auto,*" RowSpacing="5">
                <Border Grid.Row="0"
                        Classes="tool-panel docked-top-toolbar">
                    <Grid ColumnDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,*,Auto">
                        <Button Grid.Column="0" Classes="compact" Click="OnAddClick">
                            <StackPanel Orientation="Horizontal" Spacing="7">
                                <TextBlock Classes="icon" Text="{x:Static theming:LucideIcons.plus}"/>
                                <TextBlock Text="{x:Static res:Strings.HotkeySettingsWindow_Add}"/>
                            </StackPanel>
                        </Button>
                        <Button Grid.Column="1" Classes="compact" Click="OnRemoveClick" IsEnabled="{Binding HasSelection}">
                            <StackPanel Orientation="Horizontal" Spacing="7">
                                <TextBlock Classes="icon" Text="{x:Static theming:LucideIcons.trash_2}"/>
                                <TextBlock Text="{x:Static res:Strings.HotkeySettingsWindow_Remove}"/>
                            </StackPanel>
                        </Button>
                        <Button Grid.Column="2" Classes="compact" Click="OnEditClick" IsEnabled="{Binding HasSelection}">
                            <StackPanel Orientation="Horizontal" Spacing="7">
                                <TextBlock Classes="icon" Text="{x:Static theming:LucideIcons.settings_2}"/>
                                <TextBlock Text="{x:Static res:Strings.HotkeySettingsWindow_EditTask}"/>
                            </StackPanel>
                        </Button>
                        <Button Grid.Column="3" Classes="compact" Click="OnDuplicateClick" IsEnabled="{Binding HasSelection}">
                            <StackPanel Orientation="Horizontal" Spacing="7">
                                <TextBlock Classes="icon" Text="{x:Static theming:LucideIcons.copy_plus}"/>
                                <TextBlock Text="{x:Static res:Strings.HotkeySettingsWindow_Duplicate}"/>
                            </StackPanel>
                        </Button>
                        <Button Grid.Column="4" Classes="toolbar-button" Click="OnMoveUpClick"
                                Height="34" Width="34" MinWidth="34" Padding="0"
                                IsEnabled="{Binding CanMove}" ToolTip.Tip="{x:Static res:Strings.HotkeySettingsWindow_MoveUp}">
                            <TextBlock Classes="icon" Text="{x:Static theming:LucideIcons.chevron_up}" FontSize="16"/>
                        </Button>
                        <Button Grid.Column="5" Classes="toolbar-button" Click="OnMoveDownClick"
                                Height="34" Width="34" MinWidth="34" Padding="0"
                                IsEnabled="{Binding CanMove}" ToolTip.Tip="{x:Static res:Strings.HotkeySettingsWindow_MoveDown}">
                            <TextBlock Classes="icon" Text="{x:Static theming:LucideIcons.chevron_down}" FontSize="16"/>
                        </Button>
                        <Button Grid.Column="7" Classes="compact" Click="OnResetClick">
                            <StackPanel Orientation="Horizontal" Spacing="7">
                                <TextBlock Classes="icon" Text="{x:Static theming:LucideIcons.rotate_ccw}"/>
                                <TextBlock Text="{x:Static res:Strings.HotkeySettingsWindow_ResetWithEllipsis}"/>
                            </StackPanel>
                        </Button>
                    </Grid>
                </Border>

                <Border Grid.Row="1"
                        IsVisible="{Binding AreHotkeysDisabled}"
                        Background="{DynamicResource ShareX.Brush.Control.Background}"
                        BorderBrush="{DynamicResource ShareX.Brush.TaskMode.Cancel.Border}"
                        BorderThickness="1"
                        CornerRadius="4"
                        Padding="8,6">
                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="9">
                        <TextBlock Classes="icon"
                                   Text="{x:Static theming:LucideIcons.triangle_alert}"
                                   Foreground="{DynamicResource ShareX.Brush.TaskMode.Cancel.Border}"
                                   FontSize="18"/>
                        <TextBlock Grid.Column="1"
                                   Text="{x:Static res:Strings.HotkeySettingsWindow_GlobalHotkeysAreCurrentlyDisabled}"
                                   FontWeight="Normal"
                                   VerticalAlignment="Center"/>
                        <Button Grid.Column="2" Classes="compact" Click="OnEnableHotkeysClick" Content="{x:Static res:Strings.HotkeySettingsWindow_EnableHotkeys}"/>
                    </Grid>
                </Border>

                <Border Grid.Row="2" Classes="tool-panel" Padding="8">
                    <Grid RowDefinitions="Auto,*" RowSpacing="4" Grid.IsSharedSizeScope="True">
                        <Grid Grid.Row="0" Margin="4,0,4,2" ColumnSpacing="6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto" SharedSizeGroup="HotkeyGroupWidth"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Classes="column-heading" Text="{x:Static res:Strings.HotkeySettingsWindow_Task}"/>
                            <TextBlock Grid.Column="1" Classes="column-heading" Text="{x:Static res:Strings.HotkeySettingsWindow_Hotkey}"/>
                        </Grid>

                        <Grid Grid.Row="1">
                            <ScrollViewer HorizontalScrollBarVisibility="Disabled"
                                          ScrollViewer.VerticalScrollBarVisibility="Auto">
                                <StackPanel Spacing="4">
                                    <ListBox ItemsSource="{Binding Items}"
                                             SelectedItem="{Binding SelectedItem, Mode=TwoWay}"
                                             Background="Transparent"
                                             BorderThickness="0"
                                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                             ScrollViewer.VerticalScrollBarVisibility="Disabled">
                                        <ListBox.ItemTemplate>
                                            <DataTemplate x:DataType="local:HotkeySettingsItem">
                                                <Border Classes="hotkey-item"
                                                        Classes.selected="{Binding IsSelected}"
                                                        PointerPressed="OnHotkeyItemPointerPressed">
                                                    <Border.ContextMenu>
                                                        <ContextMenu>
                                                            <MenuItem Classes="compact-menu-item" Header="{x:Static res:Strings.HotkeySettingsWindow_EditTask}" Click="OnContextMenuEditClick">
                                                                <MenuItem.Icon>
                                                                    <TextBlock Classes="icon accent-menu-icon" Text="{x:Static theming:LucideIcons.settings_2}" FontSize="16"/>
                                                                </MenuItem.Icon>
                                                            </MenuItem>
                                                            <MenuItem Classes="compact-menu-item" Header="{x:Static res:Strings.HotkeySettingsWindow_Duplicate}" Click="OnContextMenuDuplicateClick">
                                                                <MenuItem.Icon>
                                                                    <TextBlock Classes="icon accent-menu-icon" Text="{x:Static theming:LucideIcons.copy_plus}" FontSize="16"/>
                                                                </MenuItem.Icon>
                                                            </MenuItem>
                                                            <Separator Classes="compact-menu-separator"/>
                                                            <MenuItem Classes="compact-menu-item" Header="{x:Static res:Strings.HotkeySettingsWindow_Remove}" Click="OnContextMenuRemoveClick">
                                                                <MenuItem.Icon>
                                                                    <TextBlock Classes="icon accent-menu-icon" Text="{x:Static theming:LucideIcons.trash_2}" FontSize="16"/>
                                                                </MenuItem.Icon>
                                                            </MenuItem>
                                                        </ContextMenu>
                                                    </Border.ContextMenu>
                                                    <Grid ColumnSpacing="4">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto" SharedSizeGroup="HotkeyGroupWidth"/>
                                                        </Grid.ColumnDefinitions>
                                                        <Grid Grid.Column="0" ColumnSpacing="4">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*"/>
                                                                <ColumnDefinition Width="34"/>
                                                            </Grid.ColumnDefinitions>
                                                            <Button Classes="task-selector"
                                                                    Click="OnTaskClick"
                                                                    HorizontalAlignment="Stretch">
                                                                <Grid ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="7">
                                                                    <TextBlock Classes="icon"
                                                                               Text="{Binding SelectedTask.Icon}"
                                                                               FontSize="16"
                                                                               Width="18"
                                                                               Foreground="{DynamicResource ShareX.Brush.Accent.Start}"
                                                                               TextAlignment="Center"/>
                                                                    <TextBlock Grid.Column="1"
                                                                               Text="{Binding SelectedTask.Name}"
                                                                               FontWeight="Normal"
                                                                               TextTrimming="CharacterEllipsis"/>
                                                                    <TextBlock Grid.Column="2"
                                                                               Classes="icon"
                                                                               IsVisible="{Binding IsCustomized}"
                                                                               Text="{x:Static theming:LucideIcons.pencil}"
                                                                               FontSize="14"
                                                                               FontWeight="Normal"
                                                                               Foreground="{DynamicResource ShareX.Brush.Accent.Start}"
                                                                               VerticalAlignment="Center"
                                                                               ToolTip.Tip="{x:Static res:Strings.HotkeySettingsWindow_ThisTaskHasCustomSettings}"/>
                                                                    <TextBlock Grid.Column="3"
                                                                               Classes="icon"
                                                                               Text="{x:Static theming:LucideIcons.chevron_down}"
                                                                               FontSize="14"/>
                                                                </Grid>
                                                            </Button>
                                                            <Button Grid.Column="1"
                                                                    Classes="row-icon-button"
                                                                    Click="OnEditRowClick"
                                                                    ToolTip.Tip="{x:Static res:Strings.HotkeySettingsWindow_EditTaskSettings}">
                                                                <TextBlock Classes="icon"
                                                                           Text="{x:Static theming:LucideIcons.pencil}"
                                                                           FontSize="17"/>
                                                            </Button>
                                                        </Grid>

                                                        <Grid Grid.Column="1" ColumnSpacing="4">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="Auto" SharedSizeGroup="HotkeyButtonWidth"/>
                                                                <ColumnDefinition Width="32"/>
                                                            </Grid.ColumnDefinitions>
                                                            <Button Grid.Column="0"
                                                                    Classes="hotkey-capture"
                                                                    HorizontalAlignment="Stretch"
                                                                    Click="OnHotkeyClick"
                                                                    KeyDown="OnHotkeyKeyDown"
                                                                    KeyUp="OnHotkeyKeyUp"
                                                                    LostFocus="OnHotkeyLostFocus">
                                                                <TextBlock Text="{Binding DisplayHotkey}"
                                                                           FontWeight="Normal"
                                                                           TextAlignment="Center"
                                                                           HorizontalAlignment="Center"
                                                                           TextTrimming="CharacterEllipsis"/>
                                                            </Button>

                                                            <Grid Grid.Column="1"
                                                                  Width="32"
                                                                  Height="34"
                                                                  ToolTip.Tip="{Binding StatusText}">
                                                                <TextBlock IsVisible="{Binding IsRegistered}"
                                                                           Classes="icon"
                                                                           Text="{x:Static theming:LucideIcons.circle_check}"
                                                                           Foreground="{DynamicResource ShareX.Brush.TaskMode.Continue.Border}"
                                                                           FontSize="19"
                                                                           HorizontalAlignment="Center"/>
                                                                <TextBlock IsVisible="{Binding IsFailed}"
                                                                           Classes="icon"
                                                                           Text="{x:Static theming:LucideIcons.circle_x}"
                                                                           Foreground="{DynamicResource ShareX.Brush.TaskMode.Cancel.Border}"
                                                                           FontSize="19"
                                                                           HorizontalAlignment="Center"/>
                                                                <TextBlock IsVisible="{Binding IsNotConfigured}"
                                                                           Classes="icon"
                                                                           Text="{x:Static theming:LucideIcons.circle_dashed}"
                                                                           Foreground="{DynamicResource ShareX.Brush.Text.Secondary}"
                                                                           FontSize="19"
                                                                           HorizontalAlignment="Center"/>
                                                            </Grid>
                                                        </Grid>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>

                                    <Button Classes="add-hotkey-placeholder"
                                            Click="OnAddClick"
                                            HorizontalAlignment="Stretch"
                                            HorizontalContentAlignment="Stretch">
                                        <Border Classes="hotkey-item hotkey-placeholder-border">
                                            <Grid>
                                                <Grid ColumnSpacing="4" Opacity="0.18">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto" SharedSizeGroup="HotkeyGroupWidth"/>
                                                    </Grid.ColumnDefinitions>
                                                    <Grid Grid.Column="0" ColumnSpacing="4">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="34"/>
                                                        </Grid.ColumnDefinitions>
                                                        <Border Height="34" CornerRadius="4" Background="{DynamicResource ShareX.Brush.Control.Background}"/>
                                                        <Border Grid.Column="1" Height="34" Width="34" CornerRadius="4" Background="{DynamicResource ShareX.Brush.Control.Background}"/>
                                                    </Grid>
                                                    <Grid Grid.Column="1" ColumnSpacing="4">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto" SharedSizeGroup="HotkeyButtonWidth"/>
                                                            <ColumnDefinition Width="32"/>
                                                        </Grid.ColumnDefinitions>
                                                        <Border Grid.Column="0" Height="34" Width="120" CornerRadius="4" Background="{DynamicResource ShareX.Brush.Control.Background}"/>
                                                        <Border Grid.Column="1" Height="34" Width="32" CornerRadius="4" Background="{DynamicResource ShareX.Brush.Control.Background}"/>
                                                    </Grid>
                                                </Grid>

                                                <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                    <TextBlock Classes="icon" Text="{x:Static theming:LucideIcons.circle_plus}" FontSize="18" Foreground="{DynamicResource ShareX.Brush.Accent}"/>
                                                    <TextBlock Text="{x:Static res:Strings.HotkeySettingsWindow_Add}" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource ShareX.Brush.Text}"/>
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </Button>
                                </StackPanel>
                            </ScrollViewer>

                            <StackPanel IsVisible="{Binding IsEmpty}"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        Spacing="8"
                                        IsHitTestVisible="False">
                                <TextBlock Classes="icon"
                                           Text="{x:Static theming:LucideIcons.keyboard}"
                                           FontSize="42"
                                           Foreground="{DynamicResource ShareX.Brush.Text.Secondary}"
                                           HorizontalAlignment="Center"/>
                                <TextBlock Text="{x:Static res:Strings.HotkeySettingsWindow_AddAHotkeyToCreateAWorkflow}"
                                           FontWeight="Normal"/>
                            </StackPanel>
                        </Grid>
                    </Grid>
                </Border>
            </Grid>

            <Border ZIndex="10"
                    IsVisible="{Binding IsResetConfirmationVisible}"
                    Background="{DynamicResource ShareX.Brush.Overlay.Modal}">
                <Border Classes="tool-panel"
                        Width="390"
                        Padding="18"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center">
                    <Grid RowDefinitions="Auto,Auto,Auto" RowSpacing="12">
                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                            <TextBlock Classes="icon"
                                       Text="{x:Static theming:LucideIcons.rotate_ccw}"
                                       FontSize="20"
                                       Foreground="{DynamicResource ShareX.Brush.Accent.Start}"/>
                            <TextBlock Grid.Column="1"
                                       Classes="section-heading"
                                       Text="{x:Static res:Strings.HotkeySettingsWindow_ResetHotkeysQuestion}"/>
                        </Grid>
                        <TextBlock Grid.Row="1"
                                   Text="{x:Static res:Strings.HotkeySettingsWindow_ResetHotkeysDescription}"
                                   FontWeight="Normal"
                                   TextWrapping="Wrap"/>
                        <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
                            <Button Click="OnCancelResetClick" Content="{x:Static res:Strings.HotkeySettingsWindow_Cancel}"/>
                            <Button Classes="task-mode-button danger" Click="OnConfirmResetClick" Content="{x:Static res:Strings.HotkeySettingsWindow_Reset}"/>
                        </StackPanel>
                    </Grid>
                </Border>
            </Border>
        </Grid>
    </ThemeVariantScope>
</UserControl>
