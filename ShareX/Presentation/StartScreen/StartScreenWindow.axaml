<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="using:ShareX"
        xmlns:theming="using:ShareX.AvaloniaUI.Theming"
        xmlns:imageEditorControls="using:ShareX.ImageEditor.Presentation.Controls"
        mc:Ignorable="d"
        d:DesignWidth="1000"
        d:DesignHeight="720"
        x:Class="ShareX.StartScreenWindow"
        x:DataType="local:StartScreenViewModel"
        Title="{Binding WindowTitle}"
        Width="1000"
        Height="720"
        MinWidth="840"
        MinHeight="580"
        CanResize="True"
        Background="{DynamicResource ShareX.Brush.Background.Main}"
        WindowStartupLocation="CenterScreen">

    <Window.Styles>
        <Style Selector="Border.setting-card">
            <Setter Property="Background" Value="{DynamicResource ShareX.Brush.Background.Panel}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource ShareX.Brush.Border}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="16,12"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
        </Style>
        <Style Selector="Border.conditional-option">
            <Setter Property="ClipToBounds" Value="True"/>
            <Setter Property="MaxHeight" Value="90"/>
            <Setter Property="Opacity" Value="1"/>
            <Setter Property="IsHitTestVisible" Value="True"/>
            <Setter Property="Transitions">
                <Transitions>
                    <DoubleTransition Property="MaxHeight" Duration="0:0:0.22"/>
                    <DoubleTransition Property="Opacity" Duration="0:0:0.16"/>
                    <ThicknessTransition Property="Margin" Duration="0:0:0.22"/>
                </Transitions>
            </Setter>
            <Style Selector="^.hidden">
                <Setter Property="MaxHeight" Value="0"/>
                <Setter Property="Opacity" Value="0"/>
                <Setter Property="Margin" Value="0"/>
                <Setter Property="IsHitTestVisible" Value="False"/>
            </Style>
        </Style>
        <Style Selector="Border.setting-icon">
            <Setter Property="Width" Value="38"/>
            <Setter Property="Height" Value="38"/>
            <Setter Property="CornerRadius" Value="9"/>
            <Setter Property="Background" Value="{DynamicResource ShareX.Brush.Control.Background}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style Selector="TextBlock.setting-title">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style Selector="ComboBox.option-control">
            <Setter Property="Width" Value="190"/>
            <Setter Property="MinHeight" Value="38"/>
            <Setter Property="Padding" Value="9,5"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style Selector="Button.primary">
            <Setter Property="Background" Value="{DynamicResource ShareX.Brush.Accent}"/>
            <Setter Property="Foreground" Value="{DynamicResource ShareX.Brush.Accent.Foreground}"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="MinHeight" Value="42"/>
            <Setter Property="Padding" Value="20,8"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
    </Window.Styles>

    <ThemeVariantScope>
        <Grid ColumnDefinitions="340,*"
              Background="{DynamicResource ShareX.Brush.Background.Main}">
            <Border Grid.Column="0"
                    Background="{DynamicResource ShareX.Brush.Accent}"
                    ClipToBounds="True">
                <Grid>
                    <Canvas IsHitTestVisible="False">
                        <Ellipse Width="280" Height="280" Canvas.Left="185" Canvas.Top="-105" Fill="#18FFFFFF"/>
                        <Ellipse Width="170" Height="170" Canvas.Left="-72" Canvas.Top="465" Fill="#12FFFFFF"/>
                        <Ellipse Width="72" Height="72" Canvas.Left="270" Canvas.Top="430" Fill="#10FFFFFF"/>
                    </Canvas>

                    <Grid Margin="38,42,38,36" RowDefinitions="*,Auto">
                        <StackPanel VerticalAlignment="Center" Spacing="18">
                            <StackPanel Spacing="8">
                                <TextBlock Text="{Binding WelcomeTitle}"
                                           FontSize="31"
                                           FontWeight="Bold"
                                           Foreground="White"
                                           TextWrapping="Wrap"/>
                                <TextBlock Text="{Binding WelcomeSubtitle}"
                                           HorizontalAlignment="Left"
                                           FontSize="15"
                                           FontWeight="Normal"
                                           Foreground="#E8FFFFFF"
                                           LineHeight="22"
                                           TextWrapping="Wrap"/>
                            </StackPanel>

                            <StackPanel Spacing="12">
                                <Grid ColumnDefinitions="28,*" ColumnSpacing="8">
                                    <TextBlock Classes="icon" Text="{x:Static theming:LucideIcons.camera}" FontSize="18" Foreground="White"/>
                                    <TextBlock Grid.Column="1" Text="{Binding CaptureFeature}" Foreground="White" FontWeight="Normal"/>
                                </Grid>
                                <Grid ColumnDefinitions="28,*" ColumnSpacing="8">
                                    <TextBlock Classes="icon" Text="{x:Static theming:LucideIcons.wand_sparkles}" FontSize="18" Foreground="White"/>
                                    <TextBlock Grid.Column="1" Text="{Binding AutomateFeature}" Foreground="White" FontWeight="Normal"/>
                                </Grid>
                                <Grid ColumnDefinitions="28,*" ColumnSpacing="8">
                                    <TextBlock Classes="icon" Text="{x:Static theming:LucideIcons.zap}" FontSize="18" Foreground="White"/>
                                    <TextBlock Grid.Column="1" Text="{Binding ShareFeature}" Foreground="White" FontWeight="Normal"/>
                                </Grid>
                            </StackPanel>
                        </StackPanel>

                        <TextBlock Grid.Row="1"
                                   Text="{Binding PlatformNote}"
                                   FontSize="11"
                                   Foreground="#C8FFFFFF"
                                   FontWeight="Normal"/>
                    </Grid>
                </Grid>
            </Border>

            <Grid Grid.Column="1"
                  Margin="42,34,42,36"
                  RowDefinitions="Auto,*,Auto">
                <StackPanel Spacing="5">
                    <TextBlock Text="{Binding PersonalizeTitle}"
                               FontSize="25"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource ShareX.Brush.Text}"/>
                    <TextBlock Text="{Binding PersonalizeSubtitle}"
                               FontSize="13"
                               FontWeight="Normal"
                               Foreground="{DynamicResource ShareX.Brush.Text.Secondary}"/>
                </StackPanel>

                <ScrollViewer Grid.Row="1"
                              Margin="0,22,0,18"
                              HorizontalScrollBarVisibility="Disabled"
                              VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <Border Classes="setting-card">
                            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                                <Border Classes="setting-icon">
                                    <TextBlock Classes="icon"
                                               Text="{x:Static theming:LucideIcons.languages}"
                                               FontSize="19"
                                               Foreground="{DynamicResource ShareX.Brush.Accent.Start}"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"/>
                                </Border>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                    <TextBlock Classes="setting-title" Text="{Binding LanguageLabel}"/>
                                </StackPanel>
                                <ComboBox Grid.Column="2"
                                          Classes="option-control"
                                          ItemsSource="{Binding LanguageOptions}"
                                          SelectedItem="{Binding SelectedLanguage, Mode=TwoWay}">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate x:DataType="local:StartScreenLanguageOption">
                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                <Grid Width="16" Height="16">
                                                    <TextBlock Classes="icon"
                                                               Text="{Binding IconGlyph}"
                                                               FontSize="16"
                                                               HorizontalAlignment="Center"
                                                               VerticalAlignment="Center"/>
                                                    <Image Source="{Binding Flag}" Stretch="Uniform"/>
                                                </Grid>
                                                <TextBlock Text="{Binding DisplayName}" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                            </Grid>
                        </Border>

                        <Border Classes="setting-card">
                            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                                <Border Classes="setting-icon">
                                    <TextBlock Classes="icon"
                                               Text="{x:Static theming:LucideIcons.rocket}"
                                               FontSize="19"
                                               Foreground="{DynamicResource ShareX.Brush.Accent.Start}"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"/>
                                </Border>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                    <TextBlock Classes="setting-title" Text="{Binding StartWithWindowsText}"/>
                                </StackPanel>
                                <ToggleSwitch Grid.Column="2"
                                              VerticalAlignment="Center"
                                              IsEnabled="{Binding StartWithWindowsEnabled}"
                                              IsChecked="{Binding StartWithWindows, Mode=TwoWay}"/>
                            </Grid>
                        </Border>

                        <Border Classes="setting-card">
                            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                                <Border Classes="setting-icon">
                                    <TextBlock Classes="icon"
                                               Text="{x:Static theming:LucideIcons.monitor}"
                                               FontSize="19"
                                               Foreground="{DynamicResource ShareX.Brush.Accent.Start}"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"/>
                                </Border>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                    <TextBlock Classes="setting-title" Text="{Binding FollowSystemThemeLabel}"/>
                                </StackPanel>
                                <ToggleSwitch Grid.Column="2"
                                              VerticalAlignment="Center"
                                              IsChecked="{Binding UseSystemTheme, Mode=TwoWay}"/>
                            </Grid>
                        </Border>

                        <Border Classes="setting-card conditional-option"
                                Classes.hidden="{Binding UseSystemTheme}">
                            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                                <Border Classes="setting-icon">
                                    <TextBlock Classes="icon"
                                               Text="{x:Static theming:LucideIcons.sun_moon}"
                                               FontSize="19"
                                               Foreground="{DynamicResource ShareX.Brush.Accent.Start}"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"/>
                                </Border>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                    <TextBlock Classes="setting-title" Text="{Binding ThemeLabel}"/>
                                </StackPanel>
                                <ComboBox Grid.Column="2"
                                          Classes="option-control"
                                          IsEnabled="{Binding CanEditTheme}"
                                          ItemsSource="{Binding ThemeOptions}"
                                          SelectedItem="{Binding SelectedTheme, Mode=TwoWay}">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate x:DataType="local:StartScreenThemeOption">
                                            <TextBlock Text="{Binding DisplayName}"/>
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                            </Grid>
                        </Border>

                        <Border Classes="setting-card">
                            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                                <Border Classes="setting-icon">
                                    <TextBlock Classes="icon"
                                               Text="{x:Static theming:LucideIcons.palette}"
                                               FontSize="19"
                                               Foreground="{DynamicResource ShareX.Brush.Accent.Start}"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"/>
                                </Border>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                    <TextBlock Classes="setting-title" Text="{Binding FollowSystemAccentColorLabel}"/>
                                </StackPanel>
                                <ToggleSwitch Grid.Column="2"
                                              VerticalAlignment="Center"
                                              IsChecked="{Binding UseSystemAccentColor, Mode=TwoWay}"/>
                            </Grid>
                        </Border>

                        <Border Classes="setting-card conditional-option"
                                Classes.hidden="{Binding UseSystemAccentColor}">
                            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                                <Border Classes="setting-icon">
                                    <TextBlock Classes="icon"
                                               Text="{x:Static theming:LucideIcons.swatch_book}"
                                               FontSize="19"
                                               Foreground="{DynamicResource ShareX.Brush.Accent.Start}"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"/>
                                </Border>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                    <TextBlock Classes="setting-title" Text="{Binding AccentColorLabel}"/>
                                </StackPanel>
                                <imageEditorControls:ColorPickerDropdown Grid.Column="2"
                                                                                Width="72"
                                                                                IsEnabled="{Binding CanEditAccentColor}"
                                                                                SelectedColorValue="{Binding AccentColor, Mode=TwoWay}"
                                                                                HorizontalAlignment="Right"
                                                                                VerticalAlignment="Center"/>
                            </Grid>
                        </Border>

                        <Border Classes="setting-card">
                            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                                <Border Classes="setting-icon">
                                    <TextBlock Classes="icon"
                                               Text="{x:Static theming:LucideIcons.cloud}"
                                               FontSize="19"
                                               Foreground="{DynamicResource ShareX.Brush.Accent.Start}"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"/>
                                </Border>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                    <TextBlock Classes="setting-title" Text="Google Drive Backup"/>
                                    <TextBlock Text="{Binding GoogleDriveStatusText}"
                                               FontSize="12"
                                               Foreground="{DynamicResource ShareX.Brush.Text.Secondary}"
                                               TextTrimming="CharacterEllipsis"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2" VerticalAlignment="Center" Orientation="Horizontal" Spacing="6">
                                    <Button Classes="compact"
                                            IsVisible="{Binding !IsGoogleDriveConnected}"
                                            IsEnabled="{Binding !IsGoogleDriveBusy}"
                                            Click="OnGoogleDriveLoginClick">
                                        <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                            <Viewbox Width="14" Height="14" VerticalAlignment="Center">
                                                <Canvas Width="24" Height="24">
                                                    <Path Fill="#4285F4" Data="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z"/>
                                                    <Path Fill="#34A853" Data="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z"/>
                                                    <Path Fill="#FBBC05" Data="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.06H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.94l2.85-2.22.81-.63z"/>
                                                    <Path Fill="#EA4335" Data="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.06l3.66 2.84c.87-2.6 3.3-4.52 6.16-4.52z"/>
                                                </Canvas>
                                            </Viewbox>
                                            <TextBlock Text="Login" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>
                                    <Button Classes="compact"
                                            IsVisible="{Binding IsGoogleDriveConnected}"
                                            IsEnabled="{Binding !IsGoogleDriveBusy}"
                                            Content="Disconnect"
                                            Click="OnGoogleDriveDisconnectClick"/>
                                </StackPanel>
                            </Grid>
                        </Border>

                    </StackPanel>
                </ScrollViewer>

                <Grid Grid.Row="2" ColumnDefinitions="*,Auto" ColumnSpacing="16">
                    <TextBlock Text="{Binding SettingsNote}"
                               FontSize="11"
                               FontWeight="Normal"
                               Foreground="{DynamicResource ShareX.Brush.Text.Secondary}"
                               HorizontalAlignment="Left"
                               TextWrapping="Wrap"
                               VerticalAlignment="Center"/>
                    <Button Grid.Column="1"
                            Classes="primary"
                            IsDefault="True"
                            Click="OnGetStartedClick">
                        <StackPanel Orientation="Horizontal" Spacing="9">
                            <TextBlock Text="{Binding GetStartedText}" VerticalAlignment="Center"/>
                            <TextBlock Classes="icon"
                                       Text="{x:Static theming:LucideIcons.arrow_right}"
                                       FontSize="16"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </Grid>
            </Grid>
        </Grid>
    </ThemeVariantScope>
</Window>
